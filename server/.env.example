PORT=5000
NODE_ENV=development

# Generate a long random value. It is required in production and must stay private.
JWT_SECRET=replace_with_a_long_random_secret

# Store only a bcrypt hash of the admin password, never the password/passcode itself.
# Create it with: npm.cmd run hash:admin -- "a-long-unique-admin-password"
ADMIN_PASSWORD_HASH=$2a$12$replace_with_a_bcrypt_hash

# Firebase Admin service account for the SERVER ONLY.
# Base64 encoding avoids newline problems in Render environment variables.
# PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content service-account.json -Raw)))
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Optional WhatsApp Business credentials. These remain on the server.
WHATSAPP_TOKEN=your_meta_system_user_permanent_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=absence_notification
WHATSAPP_VERIFY_TOKEN=a_secret_string_for_webhook_verification
