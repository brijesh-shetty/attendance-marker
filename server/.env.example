PORT=5000
NODE_ENV=development

# Generate a long random value. It is required in production and must stay private.
JWT_SECRET=replace_with_a_long_random_secret

# Store only a bcrypt hash of the admin password, never the password/passcode itself.
# Create it with: npm.cmd run hash:admin -- "a-long-unique-admin-password"
ADMIN_PASSWORD_HASH=$2a$12$replace_with_a_bcrypt_hash

# Firebase Admin service account for the SERVER ONLY.
# Base64 encoding avoids newline problems in Render environment variables.
# PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content service-account.json -Raw)))
FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

# Optional WhatsApp Business credentials. These remain on the server.
WHATSAPP_TOKEN=your_meta_system_user_permanent_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TEMPLATE_NAME=absence_notification
WHATSAPP_ADMIN_TEMPLATE=admin_absentee_alert
WHATSAPP_ADMIN_TEMPLATE_LANGUAGE=en
WHATSAPP_VERIFY_TOKEN=a_secret_string_for_webhook_verification

# Supabase Storage credentials (server-only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_RESOURCES_BUCKET=resources

# TradingView → WhatsApp alert bridge
# Generate a long random secret (openssl rand -hex 32) and put the SAME value in
# every TradingView alert JSON body — the webhook rejects any POST without it.
TRADINGVIEW_WEBHOOK_SECRET=change_me_to_a_long_random_string
# Your personal WhatsApp number in E.164 digits (no +, no spaces). Example: 919876543210
MY_PERSONAL_WA_ID=91XXXXXXXXXX
# The Meta-approved Utility template the webhook fires. Must have 4 body
# variables in this order: {{1}} symbol, {{2}} action, {{3}} price, {{4}} note
TRADINGVIEW_TEMPLATE_NAME=trading_alert
TRADINGVIEW_TEMPLATE_LANGUAGE=en
